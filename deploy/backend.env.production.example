# Chiste Studio AI — production backend env (example)
# Real .env is written/updated by deploy/install_server.sh and deploy/repair.sh.
MONGO_URL=mongodb://localhost:27017
DB_NAME=chiste_prod
CORS_ORIGINS=https://hazlocon.com,https://www.hazlocon.com
MEDIA_DIR=/opt/hazlocon/backend/media_store
PORT=8013

# AI keys (injected from base64 by the deploy scripts — do NOT hand-edit)
EMERGENT_LLM_KEY=INJECTED_BY_DEPLOY_SCRIPT
ELEVENLABS_API_KEY=INJECTED_BY_DEPLOY_SCRIPT

# Optional: force a subtitle font path (auto-detected if omitted)
# SUBTITLE_FONT_PATH=/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf
